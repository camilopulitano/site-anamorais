---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ObraCard from '../components/ObraCard.astro';
import { obraPorSlug } from '../content/obras';
import { idiomaDe, rota } from '../i18n/idiomas';
import { t } from '../i18n/ui';
import atelie from '../assets/ana/atelier-hibiscos.jpg';
import pintando from '../assets/ana/pintando-hibisco.jpg';
import mao from '../assets/ana/mao-pincel.jpg';
import cavalete from '../assets/ana/cavalete-luz.jpg';
import janela from '../assets/ana/janela-sorrindo.jpg';

const lang = idiomaDe(Astro.url);
const T = t(lang);
const janelaObra = obraPorSlug('janela-para-a-toscana');
const fotosAtelie = [pintando, mao, cavalete].map((src, i) => ({ src, alt: T.sobre.fotosAtelie[i] }));
---

<BaseLayout titulo={T.menu.sobre} descricao={T.sobre.descricao} imagem={atelie} paginaAtual="sobre">
  <section class="conteiner abertura">
    <figure class="foto">
      <Image
        src={atelie}
        alt={T.sobre.fotoAlt}
        widths={[420, 640, 960]}
        sizes="(max-width: 900px) 92vw, 480px"
        quality={78}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{T.sobre.legendaAntes} <em lang="pt-BR">Hibiscos</em>{lang === 'zh' ? '。' : '.'}</figcaption>
    </figure>

    <div class="texto">
      <div class="pilha">
        <p class="sobrancelha">{T.menu.sobre}</p>
        <h1>Ana Quintanas</h1>
      </div>
      <div class="corpo">
        {T.sobre.paragrafos.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="faixa-mata">
    <blockquote class="conteiner">
      <p>{T.sobre.citacao}</p>
    </blockquote>
  </section>

  <section class="conteiner atelie" aria-labelledby="titulo-atelie">
    <p class="sobrancelha" id="titulo-atelie">{T.videos.sobrancelha}</p>
    <div class="trio">
      {
        fotosAtelie.map((f) => (
          <div class="item" style={`--p: ${(f.src.width / f.src.height).toFixed(4)}`}>
            <Image
              src={f.src}
              alt={f.alt}
              widths={[360, 640, 960]}
              sizes="(max-width: 700px) 92vw, 40vw"
              quality={74}
              format="webp"
              loading="lazy"
              data-fade=""
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="conteiner fecho" aria-label={janelaObra.titulo}>
    <Image
      src={janela}
      alt={T.sobre.janelaAlt}
      widths={[420, 640, 960]}
      sizes="(max-width: 900px) 92vw, 480px"
      quality={76}
      format="webp"
      loading="lazy"
      class="foto-janela"
      data-fade=""
    />
    <div class="obra-par">
      <ObraCard obra={janelaObra} sizes="(max-width: 900px) 70vw, 380px" legenda="linha" />
      <a class="botao" href={rota(lang, '/obras')}>{T.inicio.verObras}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .abertura {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: start;
    padding-block: clamp(48px, 6vw, 96px) clamp(72px, 9vw, 128px);
  }

  .foto {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  figcaption {
    font-size: 13px;
    color: var(--tinta-suave);
  }

  figcaption em {
    font-family: var(--serif);
    font-size: 15px;
  }

  .texto {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: clamp(0px, 2vw, 24px);
  }

  .pilha {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: clamp(48px, 5.5vw, 72px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .corpo {
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 620px;
    font-family: var(--serif);
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.62;
  }

  .faixa-mata {
    background: var(--mata);
    color: var(--linho);
  }

  blockquote {
    margin: 0 auto;
    padding-block: clamp(72px, 9vw, 120px);
  }

  blockquote p {
    max-width: 1040px;
    margin-inline: auto;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.22;
    letter-spacing: -0.015em;
    text-align: center;
  }

  .atelie {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: clamp(72px, 9vw, 128px);
  }

  /* Mesma altura, larguras proporcionais: nenhuma foto é cortada. */
  .trio {
    display: flex;
    gap: 16px;
  }

  .trio .item {
    flex: var(--p) 1 0;
    min-width: 0;
  }

  .fecho {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
    padding-bottom: clamp(72px, 9vw, 128px);
  }

  .obra-par {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    max-width: 380px;
  }

  .obra-par :global(.card) {
    width: 100%;
  }

  @media (max-width: 900px) {
    .abertura,
    .fecho {
      grid-template-columns: minmax(0, 1fr);
    }

    .obra-par {
      max-width: 100%;
    }
  }

  @media (max-width: 700px) {
    .trio {
      flex-direction: column;
    }
  }
</style>
