---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
import { videos } from '../content/videos';
import { INSTAGRAM_URL, INSTAGRAM_USUARIO } from '../config/contato';
import { idiomaDe } from '../i18n/idiomas';
import { t } from '../i18n/ui';
import { legendaDoVideo } from '../i18n/obras';

const lang = idiomaDe(Astro.url);
const T = t(lang);
---

<BaseLayout titulo={T.videos.titulo} descricao={T.videos.descricao} paginaAtual="videos">
  <div class="conteiner pagina">
    <header class="topo">
      <p class="sobrancelha">{T.videos.sobrancelha}</p>
      <h1>{T.videos.titulo}</h1>
      <p>{T.videos.intro}</p>
    </header>

    <ul class="grade" role="list">
      {
        videos.map((v) => (
          <li>
            <InstagramEmbed url={v.url} rotulo={T.videos.verVideo} />
            <p class="legenda">{legendaDoVideo(v.url, v.legenda, lang)}</p>
          </li>
        ))
      }
    </ul>

    <a class="botao botao--contorno mais" href={INSTAGRAM_URL} target="_blank" rel="noopener">
      {T.videos.mais} · @{INSTAGRAM_USUARIO}<span class="so-leitor"> {T.novaAba}</span>
    </a>
  </div>
</BaseLayout>

<style>
  .pagina {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(48px, 6vw, 80px) clamp(72px, 9vw, 128px);
  }

  .topo {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }

  h1 {
    font-size: clamp(44px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .topo p:not(.sobrancelha) {
    font-family: var(--serif);
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 48px clamp(24px, 4vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grade li {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .legenda {
    max-width: 420px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .mais {
    align-self: flex-start;
    text-align: center;
  }

  @media (max-width: 560px) {
    .mais {
      align-self: stretch;
    }
  }
</style>
