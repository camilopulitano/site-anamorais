---
import { Image } from 'astro:assets';
import Selo from './Selo.astro';
import DicaWhatsApp from './DicaWhatsApp.astro';
import { imagemDe, TEMAS, type Obra } from '../content/obras';

interface Props {
  obra: Obra;
  /** Atributo sizes da imagem: quanto da tela ela ocupa. */
  sizes: string;
  /**
   * Só a imagem principal da página carrega com prioridade. Várias imagens
   * "ansiosas" disputam banda e atrasam justamente o elemento do LCP.
   */
  prioridade?: boolean;
  /** Título e selo lado a lado (galeria) ou empilhados (faixas). */
  legenda?: 'linha' | 'pilha';
  /** Mostra o tema pequeno acima do título. */
  mostrarTema?: boolean;
}

const { obra, sizes, prioridade = false, legenda = 'pilha', mostrarTema = false } = Astro.props;
const imagem = imagemDe(obra);
const ficha = `/obras/${obra.slug}`;
---

<!--
  A imagem e o título levam à ficha da obra.
  O botão verde "Consultar valor", por cima da imagem, abre o WhatsApp.
  (São links irmãos, não um dentro do outro — link dentro de link não é HTML válido.)
-->
<article class="card">
  <div class="quadro com-consultar">
    <a class="moldura" href={ficha} style={`aspect-ratio: ${imagem.width} / ${imagem.height}`}>
      <Image
        src={imagem}
        alt={obra.alt}
        widths={[360, 560, 800, 1200]}
        sizes={sizes}
        quality={72}
        format="webp"
        loading={prioridade ? 'eager' : 'lazy'}
        fetchpriority={prioridade ? 'high' : 'auto'}
        decoding="async"
        data-fade={prioridade ? undefined : ''}
      />
    </a>
    <DicaWhatsApp obra={obra} />
  </div>
  <div class:list={['legenda', legenda]}>
    <span class="textos">
      {mostrarTema && <span class="tema">{TEMAS[obra.tema]}</span>}
      <a class="titulo" href={ficha}>{obra.titulo}</a>
    </span>
    <Selo situacao={obra.situacao} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Esqueleto: a moldura já ocupa o espaço da obra, na proporção dela,
     antes da imagem chegar. */
  .moldura {
    display: block;
    width: 100%;
    background: rgba(36, 30, 22, 0.06);
    box-shadow: var(--sombra-obra);
    overflow: hidden;
  }

  .moldura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 420ms var(--entrada), transform 600ms var(--entrada);
  }

  .card:hover .moldura :global(img) {
    transform: scale(1.015);
  }

  .legenda {
    display: flex;
    gap: 8px 12px;
  }

  .legenda.pilha {
    flex-direction: column;
  }

  .legenda.linha {
    justify-content: space-between;
    align-items: center;
  }

  .textos {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tema {
    font-size: 12px;
    color: var(--tinta-suave);
  }

  .titulo {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.3;
    color: var(--tinta);
    text-decoration: none;
    transition: color var(--duracao) var(--entrada);
  }

  .card:hover .titulo {
    color: var(--mata);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .moldura :global(img) {
      transform: none;
    }
  }
</style>
