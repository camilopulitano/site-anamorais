---
/**
 * Post ou Reels do Instagram dentro da página.
 *
 * Sem o script do Instagram (bloqueador, sem JavaScript, rede lenta) fica
 * um cartão simples com link para o post — nunca um buraco na página.
 * O script só é baixado quando o post chega perto da tela, e uma vez só
 * por página, não importa quantos posts houver.
 *
 * Exige na CSP (vercel.json): script-src e frame-src com https://www.instagram.com
 */
interface Props {
  /** Link do post ou do Reels, ex.: https://www.instagram.com/reel/XXXX/ */
  url: string;
  /** Texto curto do cartão de reserva. */
  rotulo?: string;
}

const { url, rotulo = 'Ver no Instagram' } = Astro.props;

// Link limpo: sem rastreadores (?stkn=, ?igsh=, ?img_index=...).
const limpo = (() => {
  const u = new URL(url);
  return `https://www.instagram.com${u.pathname.endsWith('/') ? u.pathname : `${u.pathname}/`}`;
})();
---

<div class="insta">
  <blockquote class="instagram-media" data-instgrm-permalink={`${limpo}?utm_source=ig_embed`} data-instgrm-version="14">
    <a class="reserva" href={limpo} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"></circle>
      </svg>
      <span>{rotulo}<span class="so-leitor"> (abre em nova aba)</span></span>
    </a>
  </blockquote>
</div>

<script is:inline>
  (() => {
    if (window.__instaObservando) return;
    window.__instaObservando = true;
    let carregado = false;
    const carregar = () => {
      if (carregado) return;
      carregado = true;
      const s = document.createElement('script');
      s.src = 'https://www.instagram.com/embed.js';
      s.async = true;
      document.body.appendChild(s);
    };
    const posts = document.querySelectorAll('.instagram-media');
    if (!('IntersectionObserver' in window)) return carregar();
    const obs = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          obs.disconnect();
          carregar();
        }
      },
      { rootMargin: '600px 0px' },
    );
    posts.forEach((p) => obs.observe(p));
  })();
</script>

<style>
  .insta {
    width: 100%;
    max-width: 420px;
  }

  /* Estilo do cartão de reserva. Quando o script do Instagram carrega,
     ele troca o blockquote inteiro por um iframe. */
  .insta :global(.instagram-media) {
    margin: 0 !important;
    min-width: 0 !important;
    width: 100% !important;
  }

  blockquote {
    margin: 0;
    padding: 0;
    border: 1px solid var(--linha);
    border-radius: 8px;
    background: var(--superficie);
  }

  .reserva {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 120px;
    padding: 24px;
    color: var(--tinta);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .reserva:hover {
    color: var(--mata);
  }
</style>
