---
import { Image } from 'astro:assets';
import retrato from '../assets/ana/retrato-paleta.jpg';
import { INSTAGRAM_URL, INSTAGRAM_USUARIO, linkWhatsApp, WHATSAPP_LEGIVEL } from '../config/contato';
import { idiomaDe } from '../i18n/idiomas';
import { t } from '../i18n/ui';

const T = t(idiomaDe(Astro.url));
---

<section id="contato" class="contato" aria-labelledby="titulo-contato">
  <div class="conteiner linha">
    <div class="apresentacao">
      <Image
        src={retrato}
        alt={T.contato.retratoAlt}
        width={256}
        height={256}
        fit="cover"
        position="center"
        quality={75}
        format="webp"
        loading="lazy"
        class="retrato"
      />
      <div class="textos">
        <h2 id="titulo-contato">{T.contato.titulo}</h2>
        <p>{T.contato.texto}</p>
        <p class="certificado">{T.contato.certificado}</p>
      </div>
    </div>
    <div class="acoes">
      <a class="botao" href={linkWhatsApp(T.whatsapp.ola)} rel="noopener">WhatsApp · {WHATSAPP_LEGIVEL}</a>
      <a class="botao botao--contorno" href={INSTAGRAM_URL} rel="noopener">Instagram · @{INSTAGRAM_USUARIO}</a>
    </div>
  </div>
</section>

<style>
  .contato {
    padding-block: clamp(72px, 9vw, 112px);
    scroll-margin-top: 24px;
  }

  .linha {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px 64px;
    flex-wrap: wrap;
  }

  .apresentacao {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .apresentacao :global(.retrato) {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .textos {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 560px;
  }

  h2 {
    font-size: clamp(32px, 3.4vw, 44px);
  }

  .textos p {
    font-size: 17px;
    line-height: 1.55;
    color: var(--tinta-suave);
  }

  .textos .certificado {
    font-size: 15px;
    color: var(--tinta);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .apresentacao {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .apresentacao :global(.retrato) {
      width: 104px;
      height: 104px;
    }

    .acoes,
    .acoes .botao {
      width: 100%;
    }
  }
</style>
