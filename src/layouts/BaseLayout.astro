---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { INSTAGRAM_URL } from '../config/contato';
import imagemPadrao from '../assets/obras/morro-colorido.jpg';

interface Props {
  titulo?: string;
  descricao?: string;
  /** Imagem para compartilhamento (WhatsApp, redes). */
  imagem?: ImageMetadata;
  /** Dados estruturados extras da página (schema.org). */
  jsonLd?: Record<string, unknown>;
  paginaAtual?: 'inicio' | 'obras' | 'videos' | 'sobre';
}

const {
  titulo,
  descricao = 'Portfólio de Ana Quintanas, artista plástica e pintora brasileira. Lugares, histórias e memórias: paisagens, casas e natureza pelo olhar dela.',
  imagem = imagemPadrao,
  jsonLd,
  paginaAtual,
} = Astro.props;

const tituloFinal = titulo ? `${titulo} · Ana Quintanas` : 'Ana Quintanas — pintora brasileira';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: imagem, width: 1200, format: 'jpeg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);

const pessoa = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ana Quintanas',
  jobTitle: 'Pintora',
  nationality: 'Brasileira',
  url: Astro.site?.toString(),
  sameAs: [INSTAGRAM_URL],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#24443D" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Ana Quintanas" />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Piazzolla:ital,opsz,wght@0,8..30,400;0,8..30,500;1,8..30,400&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(pessoa)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho atual={paginaAtual} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />

    <script>
      // Fade de entrada das imagens. Imagens já em cache aparecem na hora.
      const revelar = (img: HTMLImageElement) => img.classList.add('carregada');
      document.querySelectorAll<HTMLImageElement>('img[data-fade]').forEach((img) => {
        if (img.complete && img.naturalWidth > 0) revelar(img);
        else {
          img.addEventListener('load', () => revelar(img), { once: true });
          img.addEventListener('error', () => revelar(img), { once: true });
        }
      });
    </script>
    <noscript><style>img[data-fade]{opacity:1}</style></noscript>
  </body>
</html>
