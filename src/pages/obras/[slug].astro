---
import ObraView from '../../views/Obra.astro';
import { obrasComVizinhas } from '../../content/obras';

export function getStaticPaths() {
  return obrasComVizinhas().map((p) => ({ params: { slug: p.obra.slug }, props: p }));
}

const { obra, anterior, proxima } = Astro.props;
---

<ObraView obra={obra} anterior={anterior} proxima={proxima} />
