---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ObraCard from '../components/ObraCard.astro';
import { obraPorSlug } from '../content/obras';
import atelie from '../assets/ana/atelier-hibiscos.jpg';
import pintando from '../assets/ana/pintando-hibisco.jpg';
import mao from '../assets/ana/mao-pincel.jpg';
import cavalete from '../assets/ana/cavalete-luz.jpg';
import janela from '../assets/ana/janela-sorrindo.jpg';

const janelaObra = obraPorSlug('janela-para-a-toscana');
---

<BaseLayout
  titulo="Sobre"
  descricao="Ana Quintanas, artista e pintora brasileira. Grande parte do que a move na pintura vem justamente do Brasil."
  imagem={atelie}
  paginaAtual="sobre"
>
  <section class="conteiner abertura">
    <figure class="foto">
      <Image
        src={atelie}
        alt="Ana Quintanas de macacão jeans, sentada no ateliê ao lado da tela Hibiscos no cavalete; ao fundo, outras pinturas dela na prateleira"
        widths={[420, 640, 960]}
        sizes="(max-width: 900px) 92vw, 480px"
        quality={78}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>No ateliê, ao lado de <em>Hibiscos</em>.</figcaption>
    </figure>

    <div class="texto">
      <div class="pilha">
        <p class="sobrancelha">Sobre</p>
        <h1>Ana Quintanas</h1>
      </div>
      <div class="corpo">
        <p class="primeiro">
          Sou artista e pintora brasileira, e grande parte do que me move na pintura vem justamente do Brasil.
        </p>
        <p>
          Gosto de pintar aquilo que me toca e aquilo que, de alguma forma, me faz olhar para o nosso país com mais
          atenção. Podem ser paisagens, cidades, casas, natureza, cenas simples do cotidiano, cores, contrastes ou
          lugares que carregam história. Meu trabalho não está preso a um único tema, mas existe uma coisa que conecta
          tudo: o meu olhar sobre o Brasil.
        </p>
        <p>
          Eu gosto de pensar que a arte também pode fazer a gente enxergar beleza onde, muitas vezes, já acostumamos a
          passar sem perceber. Quero pintar um Brasil verdadeiro, diverso, cheio de identidade, história e beleza. Um
          Brasil que não precisa parecer com nenhum outro lugar para ser bonito.
        </p>
        <p>
          Cada obra nasce muito desse desejo: fazer com que quem olhe para a pintura reconheça alguma coisa, sinta alguma
          coisa e, quem sabe, sinta também um pouco de orgulho daquilo que é nosso.
        </p>
      </div>
    </div>
  </section>

  <section class="faixa-mata" aria-label="Citação">
    <blockquote class="conteiner">
      <p>
        “Eu gosto de pensar que a arte também pode fazer a gente enxergar beleza onde, muitas vezes, já acostumamos a
        passar sem perceber.”
      </p>
    </blockquote>
  </section>

  <section class="conteiner atelie" aria-labelledby="titulo-atelie">
    <p class="sobrancelha" id="titulo-atelie">No ateliê</p>
    <div class="trio">
      {
        [
          { src: pintando, alt: 'Ana pintando o miolo de um hibisco vermelho na tela' },
          { src: mao, alt: 'Mão de Ana segurando o pincel junto à tela, na luz quente da tarde' },
          { src: cavalete, alt: 'Ana sentada diante do cavalete, pintando contra a luz da janela' },
        ].map((f) => (
          <div class="item" style={`--p: ${(f.src.width / f.src.height).toFixed(4)}`}>
            <Image
              src={f.src}
              alt={f.alt}
              widths={[360, 640, 960]}
              sizes="(max-width: 700px) 92vw, 40vw"
              quality={74}
              format="webp"
              loading="lazy"
              data-fade=""
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="conteiner fecho" aria-label="Janela para a Toscana">
    <Image
      src={janela}
      alt="Ana Quintanas sorrindo, apoiada na moldura pintada de Janela para a Toscana"
      widths={[420, 640, 960]}
      sizes="(max-width: 900px) 92vw, 480px"
      quality={76}
      format="webp"
      loading="lazy"
      class="foto-janela"
      data-fade=""
    />
    <div class="obra-par">
      <ObraCard obra={janelaObra} sizes="(max-width: 900px) 70vw, 380px" legenda="linha" />
      <a class="botao" href="/obras">Ver as obras</a>
    </div>
  </section>
</BaseLayout>

<style>
  .abertura {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: start;
    padding-block: clamp(48px, 6vw, 96px) clamp(72px, 9vw, 128px);
  }

  .foto {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  figcaption {
    font-size: 13px;
    color: var(--tinta-suave);
  }

  figcaption em {
    font-family: var(--serif);
    font-size: 15px;
  }

  .texto {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: clamp(0px, 2vw, 24px);
  }

  .pilha {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: clamp(48px, 5.5vw, 72px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .corpo {
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 620px;
    font-family: var(--serif);
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.62;
  }

  .corpo .primeiro {
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .faixa-mata {
    background: var(--mata);
    color: var(--linho);
  }

  blockquote {
    margin: 0 auto;
    padding-block: clamp(72px, 9vw, 120px);
  }

  blockquote p {
    max-width: 1040px;
    margin-inline: auto;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.22;
    letter-spacing: -0.015em;
    text-align: center;
  }

  .atelie {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: clamp(72px, 9vw, 128px);
  }

  /* Mesma altura, larguras proporcionais: nenhuma foto é cortada. */
  .trio {
    display: flex;
    gap: 16px;
  }

  .trio .item {
    flex: var(--p) 1 0;
    min-width: 0;
  }

  .fecho {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
    padding-bottom: clamp(72px, 9vw, 128px);
  }

  .obra-par {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    max-width: 380px;
  }

  .obra-par :global(.card) {
    width: 100%;
  }

  @media (max-width: 900px) {
    .abertura,
    .fecho {
      grid-template-columns: minmax(0, 1fr);
    }

    .obra-par {
      max-width: 100%;
    }
  }

  @media (max-width: 700px) {
    .trio {
      flex-direction: column;
    }
  }
</style>
