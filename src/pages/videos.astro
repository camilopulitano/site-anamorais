---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
import { videos } from '../content/videos';
import { INSTAGRAM_URL, INSTAGRAM_USUARIO } from '../config/contato';
---

<BaseLayout
  titulo="Obras em vídeo"
  descricao="Vídeos de Ana Quintanas pintando: estudos de luz e sombra, o processo de cada tela e a rotina do ateliê."
  paginaAtual="videos"
>
  <div class="conteiner pagina">
    <header class="topo">
      <p class="sobrancelha">No ateliê</p>
      <h1>Obras em vídeo</h1>
      <p>O processo de pintura, do estudo de luz e sombra às cores, direto do Instagram da Ana.</p>
    </header>

    <ul class="grade" role="list">
      {
        videos.map((v) => (
          <li>
            <InstagramEmbed url={v.url} rotulo="Ver o vídeo no Instagram" />
            <p class="legenda">{v.legenda}</p>
          </li>
        ))
      }
    </ul>

    <a class="botao botao--contorno mais" href={INSTAGRAM_URL} target="_blank" rel="noopener">
      Mais vídeos no Instagram · @{INSTAGRAM_USUARIO}
    </a>
  </div>
</BaseLayout>

<style>
  .pagina {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(48px, 6vw, 80px) clamp(72px, 9vw, 128px);
  }

  .topo {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }

  h1 {
    font-size: clamp(44px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .topo p:not(.sobrancelha) {
    font-family: var(--serif);
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 48px clamp(24px, 4vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grade li {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .legenda {
    max-width: 420px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .mais {
    align-self: flex-start;
    text-align: center;
  }

  @media (max-width: 560px) {
    .mais {
      align-self: stretch;
    }
  }
</style>
