---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Selo from '../components/Selo.astro';
import FaixaObras from '../components/FaixaObras.astro';
import Contato from '../components/Contato.astro';
import DicaWhatsApp from '../components/DicaWhatsApp.astro';
import { disponiveis, imagemDe, obraPorSlug, obras } from '../content/obras';
import fotoAna from '../assets/ana/sorriso-hibiscos.jpg';

const destaque = obraPorSlug('morro-colorido');
const noAtelie = ['rua-de-pedra', 'hibiscos', 'retrato', 'janela-para-a-toscana'].map(obraPorSlug);
const brasil = ['cataratas-do-iguacu', 'casa-amarela', 'araras-azuis'].map(obraPorSlug);
const totalBrasil = obras.filter((o) => o.tema === 'brasil').length;
---

<BaseLayout paginaAtual="inicio">
  <section class="abertura conteiner">
    <div class="manifesto">
      <p class="sobrancelha">Pintora brasileira</p>
      <blockquote>
        <p>
          “Quero pintar um Brasil verdadeiro, diverso, cheio de identidade, história e beleza.
          <em>Um Brasil que não precisa parecer com nenhum outro lugar para ser bonito.</em>”
        </p>
        <footer>— Ana Quintanas</footer>
      </blockquote>
      <p class="posicionamento">
        Do morro ao casario colonial, da mata às cataratas: Ana Quintanas pinta o Brasil de todo dia — inclusive o que a
        gente se acostumou a não ver — com técnica apurada e olhar de quem é daqui.
      </p>
      <div class="acoes">
        <a class="botao" href="/obras">Ver as obras</a>
        <a class="link-seta" href="/sobre">Sobre a Ana</a>
      </div>
    </div>
    <figure class="obra-destaque">
      <div class="quadro com-consultar">
        <a href={`/obras/${destaque.slug}`}>
          <Image
            src={imagemDe(destaque)}
            alt={destaque.alt}
            widths={[420, 640, 900, 1280]}
            sizes="(max-width: 900px) 92vw, 560px"
            quality={78}
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </a>
        <DicaWhatsApp obra={destaque} />
      </div>
      <figcaption>
        <a class="titulo-obra" href={`/obras/${destaque.slug}`}>{destaque.titulo}</a>
        <Selo situacao={destaque.situacao} />
      </figcaption>
    </figure>
  </section>

  <section class="faixa-clara" aria-labelledby="titulo-disponiveis">
    <div class="conteiner secao">
      <div class="cabeca">
        <div class="pilha">
          <p class="sobrancelha">No ateliê agora</p>
          <h2 id="titulo-disponiveis">Obras disponíveis</h2>
        </div>
        <a class="link-seta" href="/obras?situacao=disponivel">Ver as {disponiveis.length} disponíveis →</a>
      </div>
      <FaixaObras obras={noAtelie} />
    </div>
  </section>

  <section class="conteiner secao" aria-labelledby="titulo-brasil">
    <div class="pilha intro-brasil">
      <p class="sobrancelha" id="titulo-brasil">Brasil</p>
      <p class="citacao">
        “Meu trabalho não está preso a um único tema, mas existe uma coisa que conecta tudo: o meu olhar sobre o
        Brasil.”
      </p>
    </div>
    <FaixaObras obras={brasil} />
    <a class="link-seta" href="/obras?tema=brasil">Ver as {totalBrasil} obras do Brasil →</a>
  </section>

  <section class="faixa-mata" aria-labelledby="titulo-sobre">
    <div class="conteiner sobre">
      <Image
        src={fotoAna}
        alt="Ana Quintanas sorrindo, sentada no ateliê diante da tela Hibiscos"
        widths={[360, 560, 800]}
        sizes="(max-width: 900px) 92vw, 380px"
        quality={74}
        format="webp"
        loading="lazy"
        class="foto-ana"
        data-fade=""
      />
      <div class="pilha texto-sobre">
        <p class="sobrancelha" id="titulo-sobre">Sobre</p>
        <p class="citacao">
          Sou artista e pintora brasileira, e grande parte do que me move na pintura vem justamente do Brasil.
        </p>
        <a class="link-seta" href="/sobre">Ler o texto da Ana →</a>
      </div>
    </div>
  </section>

  <Contato />
</BaseLayout>

<style>
  .abertura {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    padding-block: clamp(40px, 5vw, 72px) clamp(72px, 9vw, 128px);
  }

  .manifesto {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  blockquote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  blockquote p {
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.18;
    letter-spacing: -0.015em;
  }

  blockquote em {
    color: var(--mata);
  }

  blockquote footer {
    font-size: 15px;
    color: var(--tinta-suave);
  }

  .posicionamento {
    max-width: 480px;
    padding-top: 20px;
    border-top: 1px solid var(--linha);
    font-size: 17px;
    line-height: 1.6;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  .obra-destaque {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .obra-destaque :global(img) {
    max-height: 760px;
    width: auto;
    box-shadow: 0 1px 2px rgba(36, 30, 22, 0.12), 0 18px 40px rgba(36, 30, 22, 0.16);
  }

  .quadro {
    display: block;
  }

  .quadro > a {
    display: block;
  }

  figcaption {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .titulo-obra {
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    color: var(--tinta);
    text-decoration: none;
  }

  .titulo-obra:hover {
    color: var(--mata);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faixa-clara {
    background: var(--superficie);
  }

  .secao {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(72px, 9vw, 128px);
  }

  .cabeca {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 32px;
  }

  .pilha {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    font-size: clamp(32px, 3.4vw, 44px);
  }

  .citacao {
    font-family: var(--serif);
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: 1.28;
    letter-spacing: -0.01em;
  }

  .intro-brasil {
    max-width: 920px;
  }

  .secao > .link-seta {
    align-self: flex-start;
    margin-top: -16px;
  }

  .faixa-mata {
    background: var(--mata);
    color: var(--linho);
  }

  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
    padding-block: clamp(72px, 9vw, 120px);
  }

  .sobre :global(.foto-ana) {
    justify-self: end;
    width: 100%;
    max-width: 380px;
  }

  .faixa-mata .sobrancelha,
  .faixa-mata .link-seta {
    color: var(--ocre);
  }

  .faixa-mata .link-seta:hover {
    color: var(--linho);
  }

  .texto-sobre {
    gap: 28px;
    max-width: 620px;
  }

  @media (max-width: 900px) {
    .abertura,
    .sobre {
      grid-template-columns: minmax(0, 1fr);
    }

    .obra-destaque .quadro {
      width: 100%;
    }

    .obra-destaque :global(img) {
      max-height: none;
      width: 100%;
    }

    .sobre :global(.foto-ana) {
      justify-self: start;
      max-width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: 50% 25%;
    }
  }

  @media (max-width: 640px) {
    .acoes .botao {
      width: 100%;
    }
  }
</style>
